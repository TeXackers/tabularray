\RequirePackage{listings}
\RequirePackage{xcolor}
\RequirePackage{codelisting}

\newcodekey{tblr}{
  ruleht = 0,
  codeprefix = {},
  resultprefix = {},
  bckgndcolor = yellow!10!white,
  stringstyle = \color{red},
  commentstyle = \color{darkgreen},
  texcsstyle = \color{magenta},
  keywdstyle = \color{cyan},
  keywd = {
    tblr,
    talltblr,
    longtblr,
    column,
    columns,
    colspec,
    row,
    rows,
    rowspec,
    cell,cells,
    hlines,vlines,hline,vline,
    hborder,vborder,
    booktabs,longtabs,talltabs,
    tblrtikzbelow,tblrtikzabove
  },
  keywd = [2]{
    halign, valign, wd, ht, width, co, si,
    colsep, colsep+, leftsep, leftsep+, rightsep, rightsep+,
    rowsep, rowsep+, abovesep, abovesep+, belowsep, belowsep+,
    bg, fg, bgcolor, fgcolor, font, mode, cmd, preto, appto,
    hlines,vlines,hline,vline,
    dash, text, leftpos, rightpos, abovepos, belowpos, endpos, rulesep,
    abovespace, abovespace+, belowspace, belowspace+,
    leftspace, leftspace+, rightspace, rightspace+, pagebreak,
    hspan, vspan, stretch, baseline, delimiter, rowhead, rowfoot,
    caption, entry, label, note, remark, more, theme,
    headsep, footsep, presep, postsep, expand, expand+, long, tall,
    evaluate, process, measure, guard, name,
    Q,X,{|},\$\$, \$
  }
}
\setlistcolorscheme{
  bckgnd = grey,
  string = darkgreen,
  comment = darkgrey,
  texcs = magenta,
  keywd = cyan,
  rule = pink,
  number = magenta
}
